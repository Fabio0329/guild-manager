# Copy to .env.local (gitignored) and fill in real values there. Every
# variable the app reads belongs here with a safe placeholder.

# Local Postgres from compose.yaml (`npm run db:up`).
DATABASE_URL="postgresql://guild_manager:guild_manager@localhost:5433/guild_manager"

# Battle.net sign-in (OIDC). Create a client at develop.battle.net (API
# Access) with this redirect URL:
#   http://localhost:3000/api/auth/callback/battlenet
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# Discord sign-in (OAuth 2.0). Create an app at
# discord.com/developers/applications; under OAuth2, add this redirect:
#   http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
